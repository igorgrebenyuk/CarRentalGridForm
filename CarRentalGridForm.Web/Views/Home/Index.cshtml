@model IReadOnlyCollection<CarRentalGridForm.Models.Car>
@{
    ViewData["Title"] = "Home Page";
}

<table class="table table-hover">
  <thead>
    <tr>
      <th scope="col">Id</th>
      <th scope="col">Бренд</th>
      <th scope="col">Государственный регистрационный номер</th>
      <th scope="col">Пробег автомобиля</th>
    </tr>
  </thead>
  <tbody>
  @foreach (var car in Model)
  {
    <tr>
      <input type="hidden" name="Id" value="Id" />
      <td>@car.Brand</td>
      <td>@car.LicensePlate</td>
      <td>@car.Mileage</td>
    </tr>
  }
  </tbody>
</table> 